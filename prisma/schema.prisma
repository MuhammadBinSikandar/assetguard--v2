// Prisma schema for AssetGuard Advanced Auth System
// Supports PostgreSQL with Neon DB

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum KycStatus {
  IDLE
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id                    String                      @id @default(uuid())
  email                 String                      @unique
  passwordHash          String
  name                  String?
  roles                 String[]                    @default(["user"]) // ["admin"] or ["user", "buyer", "seller"]
  emailVerified         Boolean                     @default(false)
  twoFactorEnabled      Boolean                     @default(false)
  twoFactorSecret       String?
  failedLoginAttempts   Int                         @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  // KYC & Blockchain fields
  kycStatus             KycStatus                   @default(IDLE)
  walletAddress         String?                     @unique
  role                  Role                        @default(USER)

  // Relations
  refreshTokens         RefreshToken[]
  emailVerification     EmailVerificationToken[]
  passwordResets        PasswordResetToken[]
  auditLogs             AuditLog[]
  kycRecord             KYCRecord?
  properties            Property[]
  propertyListings      PropertyListing[]
  listingBookmarks      ListingBookmark[]
  buyerPurchases        TokenPurchase[]  @relation("BuyerPurchases")
  sellerPurchases       TokenPurchase[]  @relation("SellerPurchases")
  propertyOwnerships    PropertyOwnership[]

  @@index([email])
  @@index([kycStatus])
  @@index([walletAddress])
  @@map("users")
}

model KYCRecord {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String    @unique // 1-to-1 relation
  fullName      String
  idNumber      String
  documentUrls  String[]  // Pinata private file CIDs (never store signed gateway URLs—they expire)
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?   // Admin user ID who reviewed
  adminNotes    String?

  @@index([userId])
  @@map("kyc_records")
}

model RefreshToken {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  hashedToken       String    @unique // bcrypt hash of the actual token
  jti               String    @unique // JWT ID for tracking
  device            String?
  ip                String?
  userAgent         String?
  revoked           Boolean   @default(false)
  revokedAt         DateTime?
  revokedReason     String?   // "logout", "reuse_detected", "expired", "manual_revoke"
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  replacedById      String?   @unique // Points to the new token ID after rotation
  replacedToken     RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedByToken   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([hashedToken])
  @@index([jti])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String?  @unique // Legacy URL-based token (optional)
  otpCode    String?  // 6-digit OTP code (hashed)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumed   Boolean  @default(false)
  consumedAt DateTime?
  attempts   Int      @default(0) // Track OTP verification attempts

  @@index([userId])
  @@index([tokenHash])
  @@index([otpCode])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumed   Boolean  @default(false)
  consumedAt DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String   // "login", "logout", "register", "password_reset", "email_verify", "token_refresh", "token_revoke", "failed_login"
  details    String?  // JSON string with additional details
  ip         String?
  userAgent  String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Property Enums ───────────────────────────────────────────────────────────

enum PropertyStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
  LAND
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ── Property Models ──────────────────────────────────────────────────────────

model Property {
  id                  String         @id @default(uuid())
  referenceId         String         @unique // PR-{YEAR}-{4-digit}, auto-generated

  // Step 1 — NYC BBL
  borough             String
  block               String
  lot                 String

  // Step 2 — Property Details
  propertyAddress     String
  ownerName           String
  propertyType        PropertyType
  taxClass            String

  // Building Information
  yearBuilt           Int?
  stories             Int?
  totalAreaSqFt       Float?
  commercialUnits     Int?           @default(0)
  residentialUnits    Int?           @default(0)

  // Land Information
  frontage            Float?
  depth               Float?
  landAreaSqFt        Float?

  // Valuation
  estimatedPriceUSD   Float
  // Admin override when user-submitted estimate is wrong; minting & displays use this when set
  verifiedPriceUSD    Float?

  // Step 4 — Wallet (ALWAYS read from authenticated session, never from client)
  walletAddress       String
  blockchainNetwork   String         @default("solana-devnet")
  tokenSymbol         String         @default("AG")

  // Status & Audit
  status              PropertyStatus @default(PENDING)
  adminNotes          String?
  reviewedBy          String?        // Admin User.id
  reviewedAt          DateTime?
  submittedAt         DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Minting (Token-2022)
  mintAddress         String?        @unique // Solana Token-2022 mint address
  mintSignature       String?        // Transaction signature from minting
  mintedAt            DateTime?      // When tokens were minted
  tokenSupply         Int?           // Total token supply minted
  pricePerToken       Float?         // USD per token at mint (valuation / supply)

  // Relations
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId             String
  documents           PropertyDocument[]
  statusHistory       PropertyStatusHistory[]
  verificationData    PropertyVerificationData?
  listings            PropertyListing[]
  tokenPurchases      TokenPurchase[]
  propertyOwnerships  PropertyOwnership[]

  @@unique([borough, block, lot]) // Prevent duplicate BBL registration
  @@index([ownerId])
  @@index([status])
  @@index([referenceId])
  @@index([mintAddress])
  @@map("properties")
}

model PropertyDocument {
  id            String         @id @default(uuid())
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String
  documentType  String         // "title_deed"
  fileName      String
  fileUrl       String         // /uploads/properties/{propertyId}/filename.ext
  mimeType      String?
  fileSizeBytes Int?
  status        DocumentStatus @default(PENDING)
  uploadedAt    DateTime       @default(now())
  verifiedAt    DateTime?
  verifiedBy    String?        // Admin User.id

  @@index([propertyId])
  @@map("property_documents")
}

model PropertyStatusHistory {
  id          String          @id @default(uuid())
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  fromStatus  PropertyStatus?
  toStatus    PropertyStatus
  changedBy   String          // User.id
  reason      String?
  createdAt   DateTime        @default(now())

  @@index([propertyId])
  @@map("property_status_history")
}

// ── Scraping / Verification ─────────────────────────────────────────────────

enum ScrapeStatus {
  PENDING
  SUCCESS
  FAILED
}

model PropertyVerificationData {
  id               String       @id @default(uuid())
  property         Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId       String       @unique // 1-to-1 relation
  scrapedAt        DateTime?
  scrapeStatus     ScrapeStatus @default(PENDING)
  scrapeError      String?

  // 13 scraped fields — all nullable strings
  address          String?
  ownerName        String?
  propertyType     String?
  taxClass         String?
  yearBuilt        String?
  numberOfStories  String?
  totalArea        String?
  residentialUnits String?
  commercialUnits  String?
  frontage         String?
  landDepth        String?
  landArea         String?
  estimatedPrice   String?

  @@index([propertyId])
  @@map("property_verification_data")
}

// ── Property Listings (marketplace) ───────────────────────────────────────

enum ListingStatus {
  ACTIVE
  SOLD
}

enum PurchaseStatus {
  PENDING
  ESCROW_RECEIVED
  COMPLETED
  FAILED
}

model PropertyListing {
  id               String         @id @default(uuid())
  propertyId       String
  property         Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  tokensListed     Int
  /** Remaining sellable tokens; set equal to tokensListed on creation, decremented on each sale. */
  tokensRemaining  Int  @default(0)
  pricePerToken    Float
  totalValue       Float
  status           ListingStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookmarks        ListingBookmark[]
  purchases        TokenPurchase[]

  @@unique([propertyId, sellerId])
  @@index([propertyId])
  @@index([sellerId])
  @@index([status])
  @@map("property_listings")
}

model TokenPurchase {
  id                    String         @id @default(uuid())
  listingId             String
  listing               PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId               String
  buyer                 User           @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId              String
  seller                User           @relation("SellerPurchases", fields: [sellerId], references: [id], onDelete: Cascade)
  propertyId            String
  property              Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tokensBought          Int
  pricePerToken         Float
  totalSolPaid          Float
  platformFeeSol        Float
  sellerReceivedSol     Float
  solPriceUsdAtPurchase Float
  buyerWallet           String
  sellerWallet          String
  solTransferTxHash     String?       @unique
  tokenTransferTxHash   String?
  solReleaseTxHash      String?
  refundTxHash          String?
  refundedAt            DateTime?
  status                PurchaseStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([propertyId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@map("token_purchases")
}

model PropertyOwnership {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokensOwned   Int
  acquiredAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, userId])
  @@index([userId])
  @@index([propertyId])
  @@map("property_ownerships")
}

model ListingBookmark {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
  @@map("listing_bookmarks")
}
