// Prisma schema for AssetGuard Advanced Auth System
// Supports PostgreSQL with Neon DB

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum KycStatus {
  IDLE
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id                    String                      @id @default(uuid())
  email                 String                      @unique
  passwordHash          String
  name                  String?
  roles                 String[]                    @default(["user"]) // ["admin"] or ["user", "buyer", "seller"]
  emailVerified         Boolean                     @default(false)
  twoFactorEnabled      Boolean                     @default(false)
  twoFactorSecret       String?
  failedLoginAttempts   Int                         @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  // KYC & Blockchain fields
  kycStatus             KycStatus                   @default(IDLE)
  walletAddress         String?                     @unique
  role                  Role                        @default(USER)

  // Relations
  refreshTokens         RefreshToken[]
  emailVerification     EmailVerificationToken[]
  passwordResets        PasswordResetToken[]
  auditLogs             AuditLog[]
  kycRecord             KYCRecord?

  @@index([email])
  @@index([kycStatus])
  @@index([walletAddress])
  @@map("users")
}

model KYCRecord {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String    @unique // 1-to-1 relation
  fullName      String
  idNumber      String
  documentUrls  String[]  // Relative paths: /uploads/kyc/file.png (swappable to IPFS hashes later)
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?   // Admin user ID who reviewed
  adminNotes    String?

  @@index([userId])
  @@map("kyc_records")
}

model RefreshToken {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  hashedToken       String    @unique // bcrypt hash of the actual token
  jti               String    @unique // JWT ID for tracking
  device            String?
  ip                String?
  userAgent         String?
  revoked           Boolean   @default(false)
  revokedAt         DateTime?
  revokedReason     String?   // "logout", "reuse_detected", "expired", "manual_revoke"
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  replacedById      String?   @unique // Points to the new token ID after rotation
  replacedToken     RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedByToken   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([hashedToken])
  @@index([jti])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String?  @unique // Legacy URL-based token (optional)
  otpCode    String?  // 6-digit OTP code (hashed)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumed   Boolean  @default(false)
  consumedAt DateTime?
  attempts   Int      @default(0) // Track OTP verification attempts

  @@index([userId])
  @@index([tokenHash])
  @@index([otpCode])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumed   Boolean  @default(false)
  consumedAt DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String   // "login", "logout", "register", "password_reset", "email_verify", "token_refresh", "token_revoke", "failed_login"
  details    String?  // JSON string with additional details
  ip         String?
  userAgent  String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
